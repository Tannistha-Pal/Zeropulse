# PostgreSQL credentials used by the postgres image and the existing DB_* backend config.
DB_NAME=zeropulse_db
DB_USER=zeropulse_user
DB_PASSWORD=replace-with-a-strong-local-password

# Required signing secret. Generate a unique random value for each environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Host ports (container ports remain PostgreSQL 5432, Redis 6379, backend 5000, Nginx 80).
BACKEND_PORT=5000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173

# Public browser paths baked into the Vite build; leave the Socket.IO URL empty to use same-origin.
VITE_API_URL=/api
VITE_SOCKET_URL=

# Optional benchmark profile. Use only a dedicated benchmark account/session.
BENCHMARK_USER_ID=
BENCHMARK_USER_EMAIL=zeropulse-benchmark@example.invalid
BENCHMARK_JWT=
BENCHMARK_API_BASE_URL=http://frontend
BENCHMARK_SOCKET_URL=http://backend:5000
BENCHMARK_REQUESTS=1000
BENCHMARK_CONCURRENCY=100
BENCHMARK_DURATION_SECONDS=
BENCHMARK_REVOCATION_TESTS=20
BENCHMARK_TIMEOUT_MS=10000
BENCHMARK_SESSION_TTL_SECONDS=1800
